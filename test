sudo -u postgres psql -d private5g -c "
WITH latest AS (
  SELECT DISTINCT ON (logical_operation)
    logical_operation,
    payload
  FROM raw_observation
  ORDER BY logical_operation, received_at DESC
)
SELECT
  logical_operation,
  jsonb_object_agg(field, jsonb_typeof(value)) AS top_level_structure
FROM latest
CROSS JOIN LATERAL jsonb_each(payload) AS item(field, value)
GROUP BY logical_operation;
"

