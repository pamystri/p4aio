SELECT
  s.name AS site,
  s.latitude AS site_latitude,
  s.longitude AS site_longitude,
  rt.name AS target,
  c.id AS cell_id,
  c.display_name AS cell,
  c.latitude AS cell_latitude,
  c.longitude AS cell_longitude
FROM site s
JOIN radio_target rt ON rt.site_id = s.id
LEFT JOIN cell c ON c.radio_target_id = rt.id
WHERE rt.id = '4a93121e-7a4b-4f45-9921-b18ad6df4345';
