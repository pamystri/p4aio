psql "$DATABASE_URL" -P pager=off -c "
SELECT
  md.namespace || '.' || md.key AS metric,
  count(*) AS observations,
  count(ro.ue_id) AS linked_to_ue,
  count(ro.cell_id) AS linked_to_cell,
  min(COALESCE(ro.value_double, ro.value_integer::double precision)) AS minimum_value,
  max(COALESCE(ro.value_double, ro.value_integer::double precision)) AS maximum_value,
  max(ro.observed_at) AS latest
FROM radio_observation ro
JOIN metric_definition md ON md.id = ro.metric_definition_id
WHERE ro.radio_target_id = '4a93121e-7a4b-4f45-9921-b18ad6df4345'
  AND md.namespace = 'radio.ue'
  AND md.key IN ('initial_ta', 'ul_path_loss', 'pusch_snr', 'epre')
GROUP BY md.namespace, md.key
ORDER BY metric;
"
