sudo nano /etc/private-5g-monitor/retention.sql



\set ON_ERROR_STOP on

BEGIN;

-- Location evidence is dependent on location estimates.
DELETE FROM location_evidence
WHERE location_estimate_id IN (
    SELECT id
    FROM location_estimate
    WHERE estimated_at < now() - interval '7 days'
);

DELETE FROM location_estimate
WHERE estimated_at < now() - interval '7 days';

-- Parsed metrics and events.
DELETE FROM radio_observation
WHERE observed_at < now() - interval '7 days';

DELETE FROM domain_event
WHERE occurred_at < now() - interval '7 days';

-- Raw API responses.
DELETE FROM raw_observation
WHERE received_at < now() - interval '7 days';

-- Poll execution history. Delete only runs no longer referenced by retained data.
DELETE FROM collection_run cr
WHERE cr.started_at < now() - interval '7 days'
  AND NOT EXISTS (
      SELECT 1 FROM raw_observation ro
      WHERE ro.collection_run_id = cr.id
  )
  AND NOT EXISTS (
      SELECT 1 FROM radio_observation ob
      WHERE ob.collection_run_id = cr.id
  );

COMMIT;

VACUUM (ANALYZE) raw_observation;
VACUUM (ANALYZE) radio_observation;
VACUUM (ANALYZE) domain_event;
VACUUM (ANALYZE) location_estimate;
VACUUM (ANALYZE) location_evidence;
VACUUM (ANALYZE) collection_run;


