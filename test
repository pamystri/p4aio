[Unit]
Description=Private 5G Monitor seven-day database retention
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/psql --dbname=private5g --file=/etc/private-5g-monitor/retention.sql
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7


